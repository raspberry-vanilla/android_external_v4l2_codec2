package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "external_v4l2_codec2_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["external_v4l2_codec2_license"],
}

cc_binary {
    name: "android.hardware.media.c2-service-v4l2",
    vendor: true,
    relative_install_path: "hw",
    defaults: [
        "libcodec2-aidl-defaults",
    ],
    srcs: [
        "service.cpp",
    ],
    shared_libs: [
        "libavservices_minijail",
        "libchrome",
        "libcutils",
        "liblog",
        "libutils",
        "libv4l2_codec2_components",
    ],
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.media.c2-service-v4l2.rc",
    src: "android.hardware.media.c2-service-v4l2.rc",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.media.c2-service-v4l2.xml",
    src: "android.hardware.media.c2-service-v4l2.xml",
    sub_dir: "vintf",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.media.c2-v4l2-default-seccomp_policy",
    src: ":android.hardware.media.c2-default-seccomp_policy",
    sub_dir: "seccomp_policy",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.media.c2-v4l2-extended-seccomp_policy",
    src: "android.hardware.media.c2-v4l2-extended-seccomp_policy",
    sub_dir: "seccomp_policy",
    installable: false,
}

apex {
    name: "com.android.hardware.media.c2.v4l2",
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,
    binaries: ["android.hardware.media.c2-service-v4l2"],

    prebuilts: [
        "android.hardware.media.c2-service-v4l2.rc",
        "android.hardware.media.c2-service-v4l2.xml",
        "android.hardware.media.c2-v4l2-default-seccomp_policy",
        "android.hardware.media.c2-v4l2-extended-seccomp_policy",
    ],
}
